{
  "expo": {
    "name": "MARK",
    "slug": "mark",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "mark",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#FAF7F2"
    },
    "ios": { "supportsTablet": false, "bundleIdentifier": "com.mark.app" },
    "android": { "package": "com.mark.app" },
    "web": { "bundler": "metro", "output": "static" },
    "plugins": ["expo-router"]
  }
}
